ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=1800
OUTPUTS_DIR=/tmp/outputs
# Automatic deletion of job files after this many hours (default 24 when absent/invalid).
FILE_RETENTION_HOURS=24
# Max concurrent deep-clean jobs per server (heavy Demucs configuration).
MAX_CONCURRENT_DEEP_JOBS=1
# Optional explicit paths. Recommended on Windows when Uvicorn cannot see FFmpeg on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
